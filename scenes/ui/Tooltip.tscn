[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_tooltip"]
script/source = "extends PanelContainer

# Egyszeru buborek-sugo: az egerkurzor mellett jelenik meg.

@onready var title_label := $VBoxContainer/Title as Label
@onready var body_label  := $VBoxContainer/Body as Label

func _ready() -> void:
	hide()
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	top_level = true

func show_at(screen_pos: Vector2, title: String, body: String = \"\") -> void:
	title_label.text = title
	body_label.text = body
	body_label.visible = body != \"\"
	position = screen_pos + Vector2(16, 16)
	show()

func hide_tip() -> void:
	hide()
"

[node name="Tooltip" type="PanelContainer"]
script = SubResource("GDScript_tooltip")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Cim"

[node name="Body" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = ""
